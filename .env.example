# Port / host for the combined Next.js + API + WebSocket server
PORT=3000
HOST=0.0.0.0

# SQLite database file (created automatically)
CODESYNC_DB=./data/codesync.db

# HS256 signing secret for session tokens. If unset, a random secret is
# generated once and stored in the database (fine for single-node setups).
# CODESYNC_SECRET=change-me-to-a-long-random-string

# Extra allowed Origins for WebSocket upgrades (comma separated). Same-host
# origins are always allowed.
# ALLOWED_ORIGINS=https://codesync.example.com

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For
# TRUST_PROXY=0

# local  = run code directly on this computer (default with `npm run dev`; NOT sandboxed,
#          needs node/python/gcc/g++/javac installed; trusted rooms only)
# piston = send code to an isolated Piston sandbox (default with `npm start`)
# CODESYNC_EXECUTOR=local

# Code execution backend (piston mode) (Piston-compatible API: POST {PISTON_URL}/execute).
# Self-hosting Piston is recommended for production.
PISTON_URL=http://localhost:2000/api/v2/piston
# PISTON_API_KEY=
